{
  "aliases": {
    "#root/*": "./*"
  },
  "rules": {
    "module_cohesion": {
      "severity": "high",
      "min_exports": 5,
      "max_components": 2,
      "exclude": [
        "src/audio/types.ts",
        "src/content/types.ts",
        "src/world/motion/character-motion.ts",
        "src/world/motion/city-layout-types.ts",
        "src/world/palette.ts"
      ]
    },
    "lcom": {
      "exclude": ["**/*"]
    },
    "high_coupling": {
      "severity": "high",
      "max_cbo": 30,
      "exclude": ["src/nth.ts"]
    },
    "hub_module": {
      "severity": "high",
      "min_fan_in": 8,
      "min_fan_out": 8,
      "max_complexity": 5
    }
  },
  "tsconfig": false
}
