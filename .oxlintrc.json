{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn"],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "oxlint-plugin-anti-slop"
    },
    {
      "name": "stylistic",
      "specifier": "@stylistic/eslint-plugin"
    },
    {
      "name": "strict-colors",
      "specifier": "./lint/gates/color-policy.mjs"
    },
    {
      "name": "size",
      "specifier": "./lint/gates/size-limits.mjs"
    },
    {
      "name": "sonarjs",
      "specifier": "eslint-plugin-sonarjs"
    }
  ],
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "browser": true
  },
  "ignorePatterns": [
    "dist/**",
    "playwright-report/**",
    "test-results/**",
    "**/*.d.ts"
  ],
  "rules": {
    // G10 (after Omer 76afd84): no relative import; start from the project root alias. lint/gates/root-imports.test.ts proves it fails.
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^\\.",
            "message": "Import from the project root, not by a relative path: write #root/src/<folder>/<file>.ts (with the .ts extension) instead of ./ or ../."
          }
        ]
      }
    ],
    // G06 Complexity, after Omer (3bfcf06 -> 176a8f0). Cyclomatic is a STATED DEPARTURE from Omer's 6, ruled by David on 2026-10-26: below
    // this every cyclomatic-only finding was a flat switch over the ten-value Phase union, a guard ladder or a run of ?? defaults, where
    // fixing it changed the score and not the design. Cognitive complexity catches the real tangles. Why and what it cost: decisions.md 10-26.
    "anti-slop/cognitive-complexity": ["error", 8],
    "anti-slop/cyclomatic-complexity": ["error", { "threshold": 15 }],
    "sonarjs/expression-complexity": ["error", { "max": 3 }],
    "anti-slop/max-lines": "off",
    "anti-slop/max-lines-per-function": "off",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "off",
    "anti-slop/no-shape-in-symbol-names": "off",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "off",
    "typescript/prefer-readonly": "off",
    "typescript/await-thenable": "off",
    "typescript/no-misused-promises": "off",
    "typescript/no-base-to-string": "off",
    "typescript/prefer-string-starts-ends-with": "off",
    "typescript/prefer-nullish-coalescing": "off",
    "typescript/prefer-promise-reject-errors": "off",
    "typescript/no-unnecessary-type-arguments": "off",
    "typescript/prefer-return-this-type": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/prefer-optional-chain": "off",
    "typescript/no-mixed-enums": "off",
    "curly": ["error", "all"],
    "no-sequences": "error",
    "one-var": ["error", "never"],
    "stylistic/max-statements-per-line": [
      "error",
      {
        "max": 1
      }
    ],
    "stylistic/brace-style": [
      "error",
      "1tbs",
      {
        "allowSingleLine": false
      }
    ],
    "stylistic/lines-between-class-members": [
      "error",
      {
        "enforce": [
          {
            "blankLine": "always",
            "prev": "method",
            "next": "*"
          },
          {
            "blankLine": "always",
            "prev": "*",
            "next": "method"
          }
        ]
      }
    ],
    "stylistic/padding-line-between-statements": [
      "error",
      {
        "blankLine": "always",
        "prev": "import",
        "next": "*"
      },
      {
        "blankLine": "any",
        "prev": "import",
        "next": "import"
      },
      {
        "blankLine": "always",
        "prev": "*",
        "next": "return"
      },
      {
        "blankLine": "always",
        "prev": "*",
        "next": ["function", "class"]
      },
      {
        "blankLine": "always",
        "prev": ["function", "class"],
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": ["const", "let", "var"],
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": "*",
        "next": ["const", "let", "var"]
      },
      {
        "blankLine": "any",
        "prev": ["const", "let", "var"],
        "next": ["const", "let", "var"]
      },
      {
        "blankLine": "always",
        "prev": "block-like",
        "next": "*"
      }
    ]
  },
  "overrides": [
    {
      // G10 covers src/ and tests/ only (R8). These run in Node outside the package, in temp sandboxes where #root is undefined, so they
      // keep relative imports. lint/gates/root-imports.test.ts pins this list: a path added here fails the test. No bare glob such as
      // *.config.ts: oxlint matches it at any depth, so it would also exempt src/x.config.ts.
      "files": ["lint/**", "scripts/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["**/*"],
      "excludeFiles": ["tests/**", "src/**/*.test.ts", "lint/**/*.test.ts"],
      "rules": {
        "no-empty-function": [
          "error",
          {
            "allow": ["arrowFunctions", "constructors", "privateConstructors"]
          }
        ],
        "no-dupe-class-members": "error",
        "default-param-last": "error",
        "no-unused-expressions": [
          "error",
          {
            "allowShortCircuit": true,
            "allowTernary": true,
            "allowTaggedTemplates": true,
            "enforceForJSX": true
          }
        ],
        "no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_"
          }
        ],
        "require-yield": "error",
        "default-case-last": "error",
        "no-useless-catch": "error",
        "no-new-wrappers": "error",
        "typescript/prefer-readonly": "error",
        "typescript/await-thenable": "error",
        "typescript/no-misused-promises": [
          "error",
          {
            "checksConditionals": true,
            "checksSpreads": true,
            "checksVoidReturn": {
              "arguments": true,
              "attributes": true,
              "inheritedMethods": true,
              "properties": true,
              "returns": true,
              "variables": true
            }
          }
        ],
        "typescript/no-base-to-string": "error",
        "typescript/prefer-string-starts-ends-with": "error",
        "typescript/prefer-nullish-coalescing": [
          "error",
          {
            "ignoreConditionalTests": true,
            "ignoreMixedLogicalExpressions": true,
            "ignoreTernaryTests": false,
            "ignorePrimitives": true
          }
        ],
        "typescript/prefer-promise-reject-errors": [
          "error",
          {
            "allowThrowingAny": true,
            "allowThrowingUnknown": true
          }
        ],
        "typescript/no-unnecessary-type-arguments": "error",
        "typescript/prefer-return-this-type": "error",
        "typescript/no-redundant-type-constituents": "error",
        "typescript/prefer-optional-chain": "error",
        "typescript/no-mixed-enums": "error",
        "typescript/no-array-delete": "error",
        "typescript/no-deprecated": "error",
        "no-dupe-else-if": "error",
        "no-duplicate-case": "error",
        "no-invalid-regexp": "off",
        "no-empty-character-class": "off",
        "no-unused-private-class-members": ["error"],
        "no-unsafe-finally": ["error"],
        "no-caller": ["error"],
        "use-isnan": ["error"],
        "no-empty-pattern": [
          "error",
          {
            "allowObjectPatternsAsParameters": false
          }
        ],
        "typescript/no-this-alias": "off",
        "no-extra-boolean-cast": ["error"],
        "no-constructor-return": ["error"],
        "no-extra-bind": ["error"],
        "no-constant-binary-expression": ["error"],
        "no-case-declarations": ["error"],
        "import/no-mutable-exports": ["error"],
        "unicorn/catch-error-name": [
          "error",
          {
            "ignore": [
              "^(e|ex)$",
              "[eE][xX][cC][eE][pP][tT][iI][oO][nN]$",
              "[eE][rR][rR]$",
              "^_",
              "^\\w\\$\\d+$",
              "^[cC][aA][uU][sS][eE]$",
              "^[rR][eE][aA][sS][oO][nN]$"
            ]
          }
        ],
        "unicorn/consistent-date-clone": ["error"],
        "unicorn/consistent-empty-array-spread": ["error"],
        "unicorn/consistent-function-scoping": [
          "error",
          {
            "checkArrowFunctions": false
          }
        ],
        "unicorn/error-message": ["error"],
        "unicorn/new-for-builtins": ["error"],
        "unicorn/no-abusive-eslint-disable": ["error"],
        "unicorn/no-accessor-recursion": ["error"],
        "unicorn/no-anonymous-default-export": ["error"],
        "unicorn/no-array-callback-reference": ["error"],
        "unicorn/no-array-for-each": ["error"],
        "unicorn/no-array-method-this-argument": ["error"],
        "no-sequences": ["error"],
        "no-empty": [
          "error",
          {
            "allowEmptyCatch": true
          }
        ],
        "no-lone-blocks": ["error"],
        "no-multi-str": ["error"],
        "no-dupe-keys": ["error"],
        "no-self-assign": ["error"],
        "no-unreachable-loop": ["error"],
        "no-unreachable": ["error"],
        "new-cap": [
          "error",
          {
            "newIsCap": true,
            "capIsNew": false,
            "properties": false
          }
        ],
        "typescript/no-inferrable-types": ["error"],
        "no-var": ["error"],
        "prefer-template": ["error"],
        "no-throw-literal": ["error"],
        "no-unsafe-negation": ["error"],
        "constructor-super": ["error"],
        "no-this-before-super": ["error"],
        "import/no-duplicates": ["error"],
        "typescript/no-misused-new": ["error"],
        "typescript/consistent-type-assertions": [
          "error",
          {
            "assertionStyle": "never"
          }
        ],
        "typescript/prefer-for-of": ["error"],
        "no-import-assign": ["error"],
        "no-unsafe-optional-chaining": ["error"],
        "no-async-promise-executor": ["error"],
        "typescript/prefer-literal-enum-member": [
          "error",
          {
            "allowBitwiseExpressions": false
          }
        ],
        "no-extend-native": ["error"],
        "no-unneeded-ternary": [
          "error",
          {
            "defaultAssignment": false
          }
        ],
        "no-useless-constructor": ["error"],
        "no-lonely-if": ["error"],
        "prefer-object-spread": ["error"],
        "prefer-spread": ["error"],
        "no-useless-call": ["error"],
        "no-self-compare": ["error"],
        "import/no-absolute-path": ["error"],
        "import/no-self-import": ["error"],
        "unicorn/no-await-expression-member": ["error"],
        "unicorn/no-instanceof-builtins": ["error"],
        "unicorn/no-invalid-fetch-options": ["error"],
        "unicorn/no-negated-condition": ["error"],
        "unicorn/no-negation-in-equality-check": ["error"],
        "unicorn/no-object-as-default-parameter": ["error"],
        "unicorn/no-single-promise-in-promise-methods": ["error"],
        "unicorn/no-thenable": ["error"],
        "unicorn/no-useless-length-check": ["error"],
        "unicorn/prefer-array-find": ["error"],
        "unicorn/prefer-array-flat": ["error"],
        "unicorn/prefer-array-flat-map": ["error"],
        "unicorn/prefer-array-index-of": ["error"],
        "unicorn/prefer-array-some": ["error"],
        "unicorn/prefer-at": ["error"],
        "unicorn/prefer-blob-reading-methods": ["error"],
        "unicorn/prefer-class-fields": ["error"],
        "unicorn/prefer-code-point": ["error"],
        "unicorn/prefer-date-now": ["error"],
        "unicorn/prefer-default-parameters": ["error"],
        "unicorn/prefer-dom-node-remove": ["error"],
        "unicorn/prefer-export-from": ["error"],
        "unicorn/prefer-includes": ["error"],
        "unicorn/prefer-math-min-max": ["error"],
        "unicorn/prefer-math-trunc": ["error"],
        "unicorn/prefer-modern-dom-apis": ["error"],
        "unicorn/prefer-modern-math-apis": ["error"],
        "typescript/no-extraneous-class": [
          "error",
          {
            "allowConstructorOnly": false,
            "allowEmpty": false,
            "allowStaticOnly": true,
            "allowWithDecorator": true
          }
        ],
        "no-sparse-arrays": ["error"],
        "typescript/prefer-namespace-keyword": ["error"],
        "getter-return": [
          "error",
          {
            "allowImplicit": false
          }
        ],
        "prefer-regex-literals": ["error"],
        "no-loss-of-precision": ["error"],
        "no-useless-escape": ["error"],
        "no-nonoctal-decimal-escape": ["error"],
        "typescript/no-confusing-non-null-assertion": ["error"],
        "typescript/no-unnecessary-type-constraint": ["error"],
        "typescript/prefer-enum-initializers": ["error"],
        "typescript/no-duplicate-enum-values": ["error"],
        "typescript/prefer-as-const": ["error"],
        "typescript/prefer-function-type": ["error"],
        "no-useless-rename": ["error"],
        "prefer-object-has-own": ["error"],
        "no-proto": ["error"],
        "unicorn/no-this-assignment": ["error"],
        "unicorn/no-typeof-undefined": ["error"],
        "unicorn/no-unreadable-iife": ["error"],
        "unicorn/no-useless-fallback-in-spread": ["error"],
        "unicorn/no-useless-promise-resolve-reject": ["error"],
        "unicorn/no-useless-spread": ["error"],
        "unicorn/numeric-separators-style": [
          "error",
          {
            "onlyIfContainsSeparator": true,
            "number": {
              "minimumDigits": 0,
              "groupLength": 3
            }
          }
        ],
        "unicorn/prefer-native-coercion-functions": ["error"],
        "unicorn/prefer-negative-index": ["error"],
        "unicorn/prefer-node-protocol": ["error"],
        "unicorn/prefer-number-properties": ["error"],
        "unicorn/prefer-prototype-methods": ["error"],
        "unicorn/prefer-set-has": ["error"],
        "unicorn/prefer-set-size": ["error"],
        "unicorn/prefer-single-call": ["error"],
        "unicorn/prefer-string-raw": ["error"],
        "unicorn/prefer-string-replace-all": ["error"],
        "unicorn/prefer-string-trim-start-end": ["error"],
        "unicorn/prefer-structured-clone": ["error"],
        "unicorn/prefer-top-level-await": ["error"],
        "unicorn/prefer-type-error": ["error"],
        "unicorn/require-module-specifiers": ["error"],
        "typescript/no-non-null-assertion": "error"
      }
    },
    {
      "files": [
        "**/*.spec.ts",
        "tests/**/*.ts",
        "src/**/*.test.ts",
        "lint/**/*.test.ts"
      ],
      "rules": {
        "typescript/consistent-type-assertions": [
          "error",
          {
            "assertionStyle": "as",
            "objectLiteralTypeAssertions": "allow"
          }
        ],
        "typescript/no-non-null-assertion": "off"
      }
    },
    {
      "files": [
        "src/content/load.ts",
        "src/audio/load/load.ts",
        "src/loose.ts",
        "src/audio/sfx.ts",
        "src/audio/load/sfx-fields.ts"
      ],
      "rules": {
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    },
    {
      "files": ["src/show/messages.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      "files": ["tests/**/*.ts", "*.config.ts"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["**/*"],
      "excludeFiles": ["tests/**", "src/**/*.test.ts", "lint/**/*.test.ts"],
      "rules": {
        "no-magic-numbers": [
          "error",
          {
            "ignore": [0, 1, -1, 2],
            "detectObjects": true,
            "enforceConst": true,
            "ignoreEnums": true,
            "ignoreNumericLiteralTypes": true
          }
        ]
      }
    },
    {
      "files": ["**/*"],
      "rules": {
        "strict-colors/no-color-literals": "error"
      }
    },
    {
      // R7 revised (David, 2026-10-23): hand-placed model geometry and materials are asset data, like Omer's GLB files, so these six
      // files are exempt from the two rules above for good. gate.ts joined on 2026-10-26, when the gate.json experiment was unwound
      // (David, decisions-2026-10-25-audit.md "Unwind it"): it is the hand-placed checkpoint gate, like its five siblings.
      // lint/gates/rules.test.ts keeps this list at exactly these six.
      "files": [
        "src/world/models/boss.ts",
        "src/world/models/characters.ts",
        "src/world/models/city.ts",
        "src/world/models/enemies.ts",
        "src/world/models/gate.ts",
        "src/world/models/showcase.ts"
      ],
      "rules": {
        "no-magic-numbers": "off",
        "strict-colors/no-color-literals": "off"
      }
    },
    {
      // G04 Size. The file and member limits are Omer's (3a0475f). The function and parameter limits are a STATED DEPARTURE from Omer's (his are
      // stricter), calibrated on the real code: 41-60-line functions and 4-parameter functions had no design value to split (G04 measure).
      // Blank lines and comments count, as Omer. Every limit lives on its rule here, and nowhere else.
      "files": ["**/*"],
      "rules": {
        "max-lines": [
          "error",
          { "max": 300, "skipBlankLines": false, "skipComments": false }
        ],
        "max-lines-per-function": [
          "error",
          {
            "max": 60,
            "skipBlankLines": false,
            "skipComments": false,
            "IIFEs": true
          }
        ],
        "max-params": ["error", { "max": 4 }],
        "size/max-members": ["error", { "max": 30 }],
        "size/max-signature-params": ["error", { "max": 4 }]
      }
    },
    {
      // In tests the function cap skips describe() callbacks (a grouping of it() blocks), so the native rule gives way to size/max-test-function-lines.
      "files": ["tests/**", "src/**/*.test.ts", "lint/**/*.test.ts"],
      "rules": {
        "max-lines-per-function": "off",
        "size/max-test-function-lines": ["error", { "max": 60 }]
      }
    },
    {
      // CARRIED TO TIER 5 by David's option 2, 10-24: these files still exceed a size limit; tier 5 (structure) splits them; this list may shrink,
      // never grow. G04 split the rest of the app one slice at a time, each removing its files here. lint/gates/size.test.ts pins it: every
      // name exists, still has a finding (so a name leaves the list the moment its file is clean), and the list is exactly the set it states.
      "files": [
        "lint/gates/audio-proof.test.ts",
        "src/main.ts",
        "tests/show.spec.ts"
      ],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "max-params": "off",
        "size/max-members": "off",
        "size/max-signature-params": "off",
        "size/max-test-function-lines": "off"
      }
    },
    {
      // R7 revised (David, 2026-10-23), applied to size: hand-placed model geometry and materials are asset data, like Omer's GLB files, so these
      // six files are exempt from the size rules for good (gate.ts joined on 2026-10-26, when gate.json was unwound: it is the hand-placed
      // checkpoint gate, like its five siblings). lint/gates/size.test.ts keeps this list at exactly these six.
      "files": [
        "src/world/models/boss.ts",
        "src/world/models/characters.ts",
        "src/world/models/city.ts",
        "src/world/models/enemies.ts",
        "src/world/models/gate.ts",
        "src/world/models/showcase.ts"
      ],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "max-params": "off",
        "size/max-members": "off",
        "size/max-signature-params": "off",
        "size/max-test-function-lines": "off"
      }
    },
    {
      // R14, option A (David, 10-27): the toon kit's part helpers take a position and a scale as separate numbers, the same hand-placed
      // values an asset file stores (ball(group, SKIN, 0, 1.62, 0.02, 0.21)), so this one file is exempt from max-params by name and from
      // nothing else. lint/gates/size.test.ts pins this block at exactly this file and checks it still needs it.
      "files": ["src/world/models/kit/kit.ts"],
      "rules": {
        "max-params": "off"
      }
    },
    {
      // G06 Complexity, procedural data (procedural-data.md): the Gate constructor (cognitive 13) is a named builder, hand-placed geometry
      // written as code. Any other function in this file is not a builder and has to move out. lint/gates/complexity.test.ts pins this list
      // at exactly this file and checks it still needs the exemption.
      "files": ["src/world/models/gate.ts"],
      "rules": {
        "anti-slop/cognitive-complexity": "off",
        "anti-slop/cyclomatic-complexity": "off",
        "sonarjs/expression-complexity": "off"
      }
    }
  ]
}
